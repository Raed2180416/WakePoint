# GeoWake API server
GOOGLE_MAPS_API_KEY=your_rotated_api_key_here
JWT_SECRET=generate_a_32plus_char_random_secret_here
APP_BUNDLE_ID=com.geowake.app
ALLOWED_ORIGINS=https://geowake.example.com
MAX_REQUESTS_PER_HOUR=1000
MAX_REQUESTS_PER_MINUTE=100

# LLM API keys for automation
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key
CEREBRAS_API_KEY=your_cerebras_key

# Telegram bot for alerts (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
