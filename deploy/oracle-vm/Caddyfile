# Replace geowake.example.com with your domain (or Oracle Cloud public IP)
# Caddy auto-provisions SSL via Let's Encrypt

geowake.example.com {
	reverse_proxy geowake-api:3000
}

share.geowake.example.com {
	reverse_proxy share-backend:3001
}

graphhopper.geowake.example.com {
	reverse_proxy graphhopper:8989
}

