# GeoWake journey-share backend — environment.
# Copy to `.env` for local dev, or set these as Railway service variables.

# Bearer token the app sends on every /v1 call (HttpShareBackend.authToken).
# REQUIRED in production. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SHARE_AUTH_TOKEN=

# HMAC secret for `?t=` recipient-link verification (optional but recommended).
# Leave EMPTY to treat `?t=` as opaque and rely on the unguessable share id as
# the sole gate (this is the client-first default — the app mints tokens with a
# per-device secret the server does not know). To activate cryptographic
# verification, set this AND align the app's share secret to the same value.
# See README "Link tokens (?t=)".
HMAC_SECRET=

# When 'true', a /j/{id} request with NO `?t=` is rejected (403). Only meaningful
# once HMAC_SECRET is set. Default off.
HMAC_REQUIRE=false

# Android App Links signing-cert fingerprint(s): SHA-256, upper-case, colon-
# separated hex. Comma-separate multiple (e.g. upload + play-signing keys).
# Get it from Play Console > App integrity, or:
#   keytool -list -v -keystore my.keystore -alias my-alias | grep SHA256
ANDROID_CERT_SHA256=
ANDROID_PACKAGE=com.example.geowake2

# CORS: leave EMPTY (locked down). Set to a single exact origin only if a browser
# client must call /v1 cross-origin. '*' is intentionally unsupported.
ALLOWED_ORIGIN=

# Hard per-IP rate limit (requests/minute across all routes).
RATE_LIMIT_PER_MIN=120

# Port. Railway injects PORT automatically; this is only for local dev.
PORT=8080
