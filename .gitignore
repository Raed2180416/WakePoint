# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# IDE specific files
.idea/
*.iml
*.iws

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub/
.pub-cache/
/build/

# Android specific
*.apk
*.aab
/android/app/build/
/android/build/
/android/.gradle
android/local.properties

# Local datasets and generated caches (too large/volatile for git)
/tools/osm_data/
/tools/.cache/

# iOS specific
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/App.framework
/ios/Flutter/Flutter.podspec

# macOS specific
/macos/Pods/
/macos/.symlinks/
/macos/Flutter/Flutter.podspec

# Symbolication related
app.*.symbols
app.*.map.json

# Environment variables and API keys
.env
.env.local
.env.production
.env.staging
*.key
**/google-services.json
**/GoogleService-Info.plist
android/key.properties

# Node dependencies (must never be committed; installed via npm/pnpm)
node_modules/
**/node_modules/

# Python virtualenvs and local setup markers
.venv/
.venv-1/
.nix-android-setup-done
# WakePoint map: transient semantic-staleness flag (runtime only)
.wake/STALE

# Web Google Maps JS key (out-of-band, never commit) — see web/maps_key.example.js
web/maps_key.js
