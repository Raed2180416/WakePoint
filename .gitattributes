# Normalize all text files to LF in the repository.
# `text=auto` lets git auto-detect binary files and leave them untouched.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to run correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Large sensor datasets: store byte-for-byte, never normalize line endings.
# NOTE: docs/Sandalsoap-whitefield/ is kept in the repo for reference but is a
# Flutter asset in pubspec.yaml — strip both before packaging a release build.
docs/Sandalsoap-whitefield/** -text

# Explicitly binary assets — never apply text/EOL filters.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.pdf      binary
*.jar      binary
*.keystore binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.zip      binary
*.so       binary
*.bin      binary
